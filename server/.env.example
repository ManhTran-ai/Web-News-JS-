PORT=4000
CORS_ORIGINS=http://localhost:5173
REFRESH_CRON=*/5 * * * *
FEED_TIMEOUT_MS=10000
RETENTION_HOURS=72
MAX_ARTICLES=1500
CONTENT_TTL_HOURS=6
CONTENT_PREFETCH_COUNT=30
CONTENT_TIMEOUT_MS=15000

# SMTP dùng để gửi mã bảo mật đặt lại mật khẩu qua email.
# Gmail: bật "Xác thực 2 bước" rồi tạo "Mật khẩu ứng dụng" (app password) 16 ký tự.
# Bỏ trống SMTP_HOST thì endpoint sẽ báo "chưa cấu hình mail".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=app-password-16-ky-tu
MAIL_FROM=your-email@gmail.com
